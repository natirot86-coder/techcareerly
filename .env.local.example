NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 019sms.co.il — Send SMS (src/lib/sms019.ts)
# TOKEN: Authentication → Bearer token, created once in the 019sms web dashboard (not username/password)
# USERNAME: the 019sms account username (sent inside the request body, separate from the token)
# SOURCE: sender ID shown to recipients — max 11 chars, letters/numbers only, no + sign
SMS_019_TOKEN=
SMS_019_USERNAME=
SMS_019_SOURCE=

# Supabase Auth → Hooks → "Send SMS hook" — points at /api/auth/send-sms-hook
# Paste the secret Supabase generates there (format: v1,whsec_...) — verifies
# that the request really came from Supabase before we call 019sms with it.
SUPABASE_AUTH_HOOK_SECRET=
